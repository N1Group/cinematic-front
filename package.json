    "@tanstack/react-query": "^5.61.5",
    "axios": "^1.7.8",
    "date-fns": "^3.6.0",
    "formik": "^2.4.6",
    "framer-motion": "^11.12.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-router": "^7.0.2",
    "socket.io-client": "^4.8.1",
    "socket.io-react-hook": "^2.4.5",
